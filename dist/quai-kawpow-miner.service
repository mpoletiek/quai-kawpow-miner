# quai-kawpow-miner as a systemd service: mines from boot, restarts after a
# failure. Install with dist/install.sh (it creates the user, puts the
# binary, config and this file in place, and enables the service), or by
# hand:
#   sudo cp quai-kawpow-miner /usr/local/bin/
#   sudo install -D -m 0644 miner.toml /etc/quai-kawpow-miner/miner.toml
#   sudo cp quai-kawpow-miner.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now quai-kawpow-miner
# Watch it with: quai-kawpow-miner watch --config /etc/quai-kawpow-miner/miner.toml
# (the full screen, from the API: set `api`), or journalctl -fu quai-kawpow-miner.
# Remove it with: sudo /usr/local/share/quai-kawpow-miner/uninstall.sh
[Unit]
Description=quai-kawpow-miner (KawPoW GPU miner for Quai Network)
Documentation=https://github.com/mpoletiek/quai-kawpow-miner
Wants=network-online.target
After=network-online.target nvidia-persistenced.service
# Keep trying for as long as it takes (a node down for an hour, a driver
# that comes up late); RestartSec spaces the attempts.
StartLimitIntervalSec=0

[Service]
Type=simple
User=miner
# Keep the driver loaded between runs, then apply [tune] (both as root:
# the "+"); a failed persistence-mode call is ignored (the "-").
ExecStartPre=+-/usr/bin/nvidia-smi -pm 1
ExecStartPre=+/usr/local/bin/quai-kawpow-miner tune --config /etc/quai-kawpow-miner/miner.toml
ExecStart=/usr/local/bin/quai-kawpow-miner mine --config /etc/quai-kawpow-miner/miner.toml --no-tui
# Exit 0: stopped on purpose. Exit 1: a run-time failure (restart).
# Exit 2: configuration, or every pool refused the login (a restart will
# not help: fix it, then `systemctl restart`).
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
# The miner stops its GPUs (up to 15 s) and delivers its last hook events.
TimeoutStopSec=45
# /var/log/quai-kawpow-miner, owned by the user, for `log_file`.
LogsDirectory=quai-kawpow-miner
# For libnvrtc when the CUDA toolkit is not on the default library path:
#Environment=LD_LIBRARY_PATH=/usr/local/cuda/lib64
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
